# Public site address (used for metadata, the sitemap and robots).
NEXT_PUBLIC_SITE_URL="https://trexfolio.com"
# Release day: set to true to show the Google Play button and hide the waitlist form. Needs a new build.
NEXT_PUBLIC_PLAY_LIVE="false"
# Waitlist route (src/app/api/waitlist/route.ts). Secrets: set them in Netlify (marked secret), never in git.
# BUTTONDOWN_API_KEY=            # Trex list's key, limited to subscribers
# TELEGRAM_BOT_TOKEN=            # the Trex bot (BotFather)
# TELEGRAM_CHAT_ID=              # the "Novarex Service Requests" group
# Tests: TELEGRAM_DRY_RUN=1 logs the ping instead of sending it; BUTTONDOWN_DRY_RUN=1 skips Buttondown.
# TELEGRAM_DRY_RUN=1
